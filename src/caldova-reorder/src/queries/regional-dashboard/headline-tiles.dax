// The three header tiles. Every number is the model's, not the app's.
// Row-level security scopes Stores to the signed-in manager's region, so
// "stores in region" is simply the stores this manager can see.
EVALUATE
ROW(
    "StoresInRegion", COUNTROWS(Stores),
    "ProductsRunningLow", [Products Running Low],
    "ReordersSentToday", [Reorders Sent Today]
)
