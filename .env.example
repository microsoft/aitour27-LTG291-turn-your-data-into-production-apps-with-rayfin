# Copy this file to .env and fill in your values. .env is gitignored.

# ---------------------------------------------------------------------------
# Fabric target
# ---------------------------------------------------------------------------

# The workspace must already exist. deploy.sh / deploy.ps1 never create or
# delete a workspace. Set the ID when you have it; otherwise set the exact
# name and the script will look it up. If both are set, they must agree.
FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=

# Created inside that workspace if they do not already exist.
FABRIC_LAKEHOUSE_NAME=caldova
FABRIC_SEMANTIC_MODEL_NAME=caldova-operations

# ---------------------------------------------------------------------------
# The Rayfin app (src/caldova-reorder)
# ---------------------------------------------------------------------------
# Reorders are written by the app into its own Fabric SQL database, which Fabric
# mirrors into OneLake as Delta. The semantic model reads RestockRequests from
# there with Direct Lake, so the app and the model can never disagree.
#
# Both ids come from the Rayfin deployment. Deploy the app first:
#
#   cd src/caldova-reorder && npx rayfin up
#
# then find the "<app name>" SQLDatabase and SQLEndpoint items in the workspace:
#
#   fabio item list --workspace <workspace> --all
RAYFIN_SQL_DATABASE_ID=
RAYFIN_SQL_ENDPOINT_ID=

# How the semantic model reads the lakehouse.
#   onelake — Direct Lake straight onto OneLake Delta files (recommended)
#   sql     — Direct Lake through the SQL analytics endpoint (fallback)
FABRIC_MODEL_STORAGE_MODE=onelake

# Optional. Assigns the workspace to this capacity before deploying.
FABRIC_CAPACITY_ID=

# ---------------------------------------------------------------------------
# Filled in by the script after a successful run. Leave blank the first time.
# ---------------------------------------------------------------------------
FABRIC_LAKEHOUSE_ID=
FABRIC_SQL_ENDPOINT_ID=
FABRIC_SEMANTIC_MODEL_ID=

# ---------------------------------------------------------------------------
# fabio environment
# ---------------------------------------------------------------------------
# The scripts never sign you in. Authenticate fabio yourself before running
# them; the scripts only check `fabio auth status` and stop if it is not ready.
#
# Leave the settings below empty for production Fabric. Set them to target a
# non-production ring — for example a workspace on daily.powerbi.com, whose
# items are invisible from the production endpoint and report as
# "WorkspaceNotFound".
#
# All four matter, and they fail at different points: the Fabric API resolves the
# workspace, OneLake carries the CSV uploads, and the Power BI API refreshes the
# model. For the daily ring:
#
#   FABIO_FABRIC_API_ENDPOINT=https://dailyapi.fabric.microsoft.com/v1
#   FABIO_POWERBI_ENDPOINT=https://dailyapi.powerbi.com/v1.0/myorg
#   FABIO_ONELAKE_DFS_ENDPOINT=https://daily-onelake.dfs.fabric.microsoft.com
#   FABIO_ONELAKE_BLOB_ENDPOINT=https://daily-onelake.blob.fabric.microsoft.com

FABIO_FABRIC_API_ENDPOINT=
FABIO_POWERBI_ENDPOINT=
FABIO_ONELAKE_DFS_ENDPOINT=
FABIO_ONELAKE_BLOB_ENDPOINT=
FABIO_FABRIC_SCOPE=
# Some rings will not issue a usable token to fabio's own app registration. Setting
# the Azure CLI client id and signing in through the browser is the way around it:
#
#   export FABIO_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46
#   fabio auth login --browser
#
# The scripts read this value and pass it through, but they never sign you in.
FABIO_CLIENT_ID=

# Optional pre-acquired bearer token, if your ring needs one rather than the
# credentials fabio picks up on its own. Treat it as a secret.
FABIO_ACCESS_TOKEN=
